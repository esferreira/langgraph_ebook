# Variáveis de ambiente para os exemplos de "LangGraph no Mundo Real"
# Copie este arquivo para .env ou exporte as variáveis no seu terminal.

# 1. Chave do provedor de LLM em nuvem (Opção B — Caps. 3, 4, 6, 7 e 8)
# Se preferir rodar 100% local (Opção A), use Ollama (ChatOllama) sem chave.
OPENAI_API_KEY="sk-sua-chave-aqui"

# 2. Segredo compartilhado HMAC-SHA256 para Webhooks internos (Cap. 5)
WEBHOOK_SECRET="segredo-corporativo-32-bytes-123"
MODO_PRODUCAO="false"

# 3. Token de autenticação do painel gerencial e banco SQLite (Cap. 8)
MANAGER_TOKEN="token-gerente-demo-123"
CAMINHO_SQLITE="memoria_corporativa.sqlite"

# 4. Integração WhatsApp Business Cloud API — Meta Oficial (Caps. 5 e 7)
META_VERIFY_TOKEN="meu_token_verificacao"
WHATSAPP_ACCESS_TOKEN="EAAG..."
WHATSAPP_PHONE_ID="102030405060"
APP_SECRET_META=""

# 5. Integração SMS Bidirecional — Twilio (Caps. 5 e 7)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_SMS="+15005550006"
TWILIO_PUBLIC_WEBHOOK_URL="https://sua-api.com/sms"
VALIDAR_TWILIO="false"

# 6. Integração Telegram Bot API e SMTP E-mail (Cap. 5)
TELEGRAM_BOT_TOKEN=""
SMTP_HOST="smtp.empresa.com.br"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
URL_SISTEMA_APROVACAO="https://api.empresa.com.br"

# 7. Banco PostgreSQL em Produção (Cap. 4 — servidor_postgres_lifespan.py)
POSTGRES_URI="postgresql://usuario:senha@localhost:5432/langgraph_db"

